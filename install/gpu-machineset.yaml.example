# GPU worker MachineSet — g5.2xlarge (NVIDIA A10G) — EXAMPLE (P7, ADR D4).
#
# Adds one GPU node for RHOAI vLLM serving. The <PLACEHOLDERS> (infra-id, AZ,
# subnet, security groups, AMI, IAM instance profile) are cluster-specific and
# generated by the installer — the easy path is to DERIVE this from an existing
# worker MachineSet instead of hand-filling:
#
#   task gpu-node          # clones a worker MachineSet -> g5.2xlarge + GPU taint
#
# ...which is why this file is an example. If you apply it by hand, copy the
# values from `oc get machineset -n openshift-machine-api <worker> -o yaml`.
#
# The NVIDIA GPU operator (installed in P1) labels the node `nvidia.com/gpu.present=true`
# (the InferenceService nodeSelector) once drivers are ready; the taint below
# keeps non-GPU pods off the node.
apiVersion: machine.openshift.io/v1beta1
kind: MachineSet
metadata:
  name: <INFRA_ID>-gpu-<AZ>
  namespace: openshift-machine-api
  labels:
    machine.openshift.io/cluster-api-cluster: <INFRA_ID>
spec:
  replicas: 1
  selector:
    matchLabels:
      machine.openshift.io/cluster-api-cluster: <INFRA_ID>
      machine.openshift.io/cluster-api-machineset: <INFRA_ID>-gpu-<AZ>
  template:
    metadata:
      labels:
        machine.openshift.io/cluster-api-cluster: <INFRA_ID>
        machine.openshift.io/cluster-api-machine-role: worker
        machine.openshift.io/cluster-api-machine-type: worker
        machine.openshift.io/cluster-api-machineset: <INFRA_ID>-gpu-<AZ>
    spec:
      taints:
        - key: nvidia.com/gpu
          value: "true"
          effect: NoSchedule
      providerSpec:
        value:
          apiVersion: machine.openshift.io/v1beta1
          kind: AWSMachineProviderConfig
          instanceType: g5.2xlarge
          ami:
            id: <WORKER_AMI_ID>
          iamInstanceProfile:
            id: <INFRA_ID>-worker-profile
          placement:
            region: us-east-1
            availabilityZone: <AZ>
          subnet:
            filters:
              - name: tag:Name
                values:
                  - <INFRA_ID>-subnet-private-<AZ>
          securityGroups:
            - filters:
                - name: tag:Name
                  values:
                    - <INFRA_ID>-node
          blockDevices:
            - ebs:
                volumeSize: 200
                volumeType: gp3
          userDataSecret:
            name: worker-user-data
          credentialsSecret:
            name: aws-cloud-credentials
          tags:
            - name: kubernetes.io/cluster/<INFRA_ID>
              value: owned
